From 995b6dd42737128b3131cad0bf30bad7e928bf37 Mon Sep 17 00:00:00 2001
From: "exe.dev user" <exedev@accord-agent.exe.xyz>
Date: Tue, 25 Aug 2026 20:33:18 +0000
Subject: [PATCH 1/2] feat: support token-injecting Slack API gateways

Co-authored-by: Shelley <shelley@exe.dev>
---
 src/enso/slack_cache.py      | 7 +++++--
 src/enso/transports/slack.py | 6 +++++-
 2 files changed, 10 insertions(+), 3 deletions(-)

diff --git a/src/enso/slack_cache.py b/src/enso/slack_cache.py
index 4984879..4fc7d6a 100644
--- a/src/enso/slack_cache.py
+++ b/src/enso/slack_cache.py
@@ -31,8 +31,11 @@ log = logging.getLogger(__name__)
 CACHE_DIR = os.path.join(CONFIG_DIR, "cache")
 CACHE_FILE = os.path.join(CACHE_DIR, "slack.json")
 
-# Slack Web API base URL.
-API = "https://slack.com/api/"
+# Slack Web API base URL. An exe.dev Slack Bot integration can provide a
+# token-injecting gateway while keeping credentials off the VM.
+API = os.environ.get("ENSO_SLACK_API_BASE_URL", "https://slack.com/api/")
+if not API.endswith("/"):
+    API += "/"
 
 # Minimum seconds between automatic refreshes of the same list to avoid
 # hammering the API if the agent spams lookups for non-existent names.
diff --git a/src/enso/transports/slack.py b/src/enso/transports/slack.py
index f0606f9..70524eb 100644
--- a/src/enso/transports/slack.py
+++ b/src/enso/transports/slack.py
@@ -1491,7 +1491,11 @@ class SlackTransport(BaseTransport):
     def start(self) -> None:
         """Start listening for Slack events via Socket Mode (blocking)."""
         log.info("Starting Slack transport with exact routes")
-        app = AsyncApp(token=self.bot_token)
+        api_base_url = os.environ.get("ENSO_SLACK_API_BASE_URL", "https://slack.com/api/")
+        if not api_base_url.endswith("/"):
+            api_base_url += "/"
+        client = AsyncWebClient(token=self.bot_token, base_url=api_base_url)
+        app = AsyncApp(client=client)
         self._client = app.client
         self._register_listeners(app)
 
-- 
