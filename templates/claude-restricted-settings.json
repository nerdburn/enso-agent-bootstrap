{
  "$comment": "enso-agent-bootstrap: read-only Claude policy for client-visible Slack channels. Written once to ~/.enso/policies/<workspace>-restricted/claude/settings.json by lib/route_channels.py, then user-owned: edit it there, not here. Based on enso's docs/examples/acme-claude-settings.json. The agent can read its workspace and answer; it cannot run commands, write files, spawn subagents, browse, or read credentials. Test it (docs/specs/permissions.md) before trusting it with a real client.",
  "disableAllHooks": true,
  "permissions": {
    "deny": [
      "Agent",
      "Bash",
      "Edit",
      "Write",
      "NotebookEdit",
      "WebFetch",
      "WebSearch",
      "Read(../**)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.config/**)",
      "Read(//**/.env)",
      "Read(~/.enso/config.json)",
      "Read(~/.enso/enso.db)",
      "Read(~/.enso/secrets/**)",
      "Read(~/.enso/policies/**)",
      "Read(~/.enso/jobs/**)"
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "network": {
      "allowedDomains": ["api.anthropic.com"],
      "strictAllowlist": true
    },
    "filesystem": {
      "denyRead": [
        "~/.ssh",
        "~/.aws",
        "~/.config",
        "~/.enso/config.json",
        "~/.enso/enso.db",
        "~/.enso/secrets",
        "~/.enso/policies",
        "~/.enso/jobs"
      ]
    },
    "credentials": {
      "envVars": [
        {"name": "OP_SERVICE_ACCOUNT_TOKEN", "mode": "deny"},
        {"name": "SLACK_BOT_TOKEN", "mode": "deny"},
        {"name": "SLACK_APP_TOKEN", "mode": "deny"},
        {"name": "GH_TOKEN", "mode": "deny"},
        {"name": "VERCEL_TOKEN", "mode": "deny"},
        {"name": "CLOUDFLARE_API_TOKEN", "mode": "deny"},
        {"name": "HEROKU_API_KEY", "mode": "deny"}
      ]
    }
  }
}
