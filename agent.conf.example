# ─────────────────────────────────────────────────────────────────────────
# enso-agent-bootstrap config. One file per agent, e.g. `ace.conf`.
# Contains SECRETS — gitignored (*.conf); keep it `chmod 600`.
# Every value can also be supplied as an environment variable to install.sh.
# ─────────────────────────────────────────────────────────────────────────

# ── Identity ─────────────────────────────────────────────────────────────
AGENT_NAME="Ace"                 # Slack bot display name + manifest name
VM_NAME="ace-agent"              # exe.dev VM; reachable as <VM_NAME>.exe.xyz
VM_CPU=2                         # used by `bootstrap.sh new-vm`
VM_MEMORY=4GB
VM_DISK=20GB

# ── Slack ────────────────────────────────────────────────────────────────
# Create the Slack app first:  ./bootstrap.sh manifest ace.conf
# → paste at https://api.slack.com/apps?new_app=1 ("From an app manifest"),
#   Install to workspace, then copy:
#   OAuth & Permissions → Bot User OAuth Token            -> xoxb-...
#   Basic Information → App-Level Tokens (connections:write) -> xapp-...
#
# SLACK_MODE=gateway  (default) tokens live in an exe.dev "Slack Bot" integration
#                     named after the VM and are injected at the network edge; the
#                     VM never holds them. `./bootstrap.sh up` creates the
#                     integration from the two tokens below and applies the
#                     vendored enso patch. Once the integration exists you may
#                     blank the tokens here.
# SLACK_MODE=direct   tokens are stored in ~/.enso/config.json on the VM.
SLACK_MODE="gateway"
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""

# Slack user IDs (U…) that get an administrative DM route to the `default`
# workspace (unrestricted `admin` policy). Space/comma separated. Find yours:
# Slack profile → ⋯ → "Copy member ID".
SLACK_OWNER_IDS="U02FB3JNB"

# Optional channel (C…) for unsolicited posts: job alerts, `enso message send`.
NOTIFY_CHANNEL=""

# ── Channels ─────────────────────────────────────────────────────────────
# Slack channels the agent answers in (when @mentioned), by name or C… id,
# space/comma separated. install.sh routes ALL of them to ONE restricted
# workspace, CHANNEL_WORKSPACE (default: the first channel's name), running
# Claude under a sandboxed read-only policy written once to
# ~/.enso/policies/<workspace>-restricted/claude/settings.json. The bot joins
# public channels itself; a private channel needs `/invite @<AGENT_NAME>`
# first (the route is added regardless, so no re-run is needed after the
# invite). Blank = the bot answers only owner DMs. Add channels later by
# extending this list and re-running install.sh.
CHANNELS=""                      # e.g. "caremobi caremobi-team"
CHANNEL_WORKSPACE=""             # e.g. "caremobi" (lowercase kebab-case)

# ── Claude ───────────────────────────────────────────────────────────────
# Claude always runs on the Claude subscription: either a long-lived token from
# `claude setup-token` (run on a machine with a browser) here, or leave it
# blank and log in once on the VM afterwards (`ssh -t <vm>.exe.xyz claude`,
# then /login). Restricted channel workspaces inherit whichever you chose.
CLAUDE_CODE_OAUTH_TOKEN=""
# Set to "exe-gateway" only to bill exe.dev's LLM gateway (llm.int.exe.xyz)
# instead of the subscription.
CLAUDE_AUTH="subscription"

# ── Tool credentials (all optional; blank = installed but unauthenticated) ─
GH_TOKEN=""                      # GitHub PAT for gh + git pushes
VERCEL_TOKEN=""                  # https://vercel.com/account/tokens
CLOUDFLARE_API_TOKEN=""          # wrangler
CLOUDFLARE_ACCOUNT_ID=""
HEROKU_API_KEY=""                # `heroku authorizations:create`

# ── Git identity on the VM ───────────────────────────────────────────────
GIT_USER_NAME="Ace (enso agent)"
GIT_USER_EMAIL="ace-agent@users.noreply.github.com"

# ── lore project memory ──────────────────────────────────────────────────
LORE_REMOTE="exedev@lore-host.exe.xyz:/srv/lore/repos"
# The project's lore context repo on the lore host (e.g. lore-caremobi). It is
# attached to the CHANNEL_WORKSPACE (lore MCP server in the restricted policy)
# and to the admin agent. Blank = "lore-<CHANNEL_WORKSPACE>" when that repo
# exists on the host; otherwise no memory until you create it (lore-onboard).
# The VM's SSH key must be registered for lore: bootstrap.sh lore-key / up.
LORE_CONTEXT=""
# lore MCP tools the channel workspace must NOT call. Everything else the
# installed lore exposes (`lore mcp --list-tools`) is allowed, so a new agent
# always gets the full current set. Default: lore_remember (pinning facts into
# the client's memory is an operator action). Add lore_sow_add etc. to taste.
LORE_DENY_TOOLS="lore_remember"

# ── Machine ──────────────────────────────────────────────────────────────
TIMEZONE="America/Vancouver"     # job schedules use the VM's local timezone
OPERATOR_NAME="Shawn Adrian"     # seeds ~/.enso/docs/operator.md

# ── Sources ──────────────────────────────────────────────────────────────
# This bootstrap targets enso 2.x. Upstream main was rewritten as 0.1.x on
# 2026-09-10 and no longer carries v2.0.0 (commit 9b1ad5d4e80da1eee73924f41b72d44cd029764b);
# install.sh refuses a non-2.x checkout. nerdburn/enso carries it on branch v2.
ENSO_REPO="https://github.com/nerdburn/enso"
ENSO_REF="v2"                    # branch, tag, or commit in ENSO_REPO (v2 = enso 2.0.0 mirror)
BOOTSTRAP_REPO="https://github.com/nerdburn/enso-agent-bootstrap"
LORE_REPO="https://github.com/nerdburn/lore"
