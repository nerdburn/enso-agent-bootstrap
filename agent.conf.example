# ─────────────────────────────────────────────────────────────────────────
# enso-agent-bootstrap config. One file per agent, e.g. `ace.conf`.
# Contains SECRETS — gitignored (*.conf); keep it `chmod 600`.
# Every value can also be supplied as an environment variable to install.sh.
# ─────────────────────────────────────────────────────────────────────────

# ── Identity ─────────────────────────────────────────────────────────────
AGENT_NAME="Ace"                 # Slack bot display name + manifest name
VM_NAME="ace-agent"              # exe.dev VM; reachable as <VM_NAME>.exe.xyz
VM_CPU=2                         # used by `bootstrap.sh new-vm`
VM_MEMORY=4GB
VM_DISK=20GB

# ── Slack ────────────────────────────────────────────────────────────────
# Create the Slack app first:  ./bootstrap.sh manifest ace.conf
# → paste at https://api.slack.com/apps?new_app=1 ("From an app manifest"),
#   Install to workspace, then copy:
#   OAuth & Permissions → Bot User OAuth Token            -> xoxb-...
#   Basic Information → App-Level Tokens (connections:write) -> xapp-...
#
# SLACK_MODE=gateway  (default) tokens live in an exe.dev "Slack Bot" integration
#                     named after the VM and are injected at the network edge; the
#                     VM never holds them. `./bootstrap.sh up` creates the
#                     integration from the two tokens below and applies the
#                     vendored enso patch. Once the integration exists you may
#                     blank the tokens here.
# SLACK_MODE=direct   tokens are stored in ~/.enso/config.json on the VM.
SLACK_MODE="gateway"
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""

# Slack user IDs (U…) that get an administrative DM route to the `default`
# workspace (unrestricted `admin` policy). Space/comma separated. Find yours:
# Slack profile → ⋯ → "Copy member ID".
SLACK_OWNER_IDS="U02FB3JNB"

# Optional channel (C…) for unsolicited posts: job alerts, `enso message send`.
NOTIFY_CHANNEL=""

# ── Claude ───────────────────────────────────────────────────────────────
# Long-lived token from `claude setup-token` (run on a machine with a browser
# and a Claude subscription). Leave EMPTY to use exe.dev's LLM gateway
# (https://llm.int.exe.xyz, billed to your exe.dev allocation) instead.
CLAUDE_CODE_OAUTH_TOKEN=""

# ── Tool credentials (all optional; blank = installed but unauthenticated) ─
GH_TOKEN=""                      # GitHub PAT for gh + git pushes
VERCEL_TOKEN=""                  # https://vercel.com/account/tokens
CLOUDFLARE_API_TOKEN=""          # wrangler
CLOUDFLARE_ACCOUNT_ID=""
HEROKU_API_KEY=""                # `heroku authorizations:create`

# ── Git identity on the VM ───────────────────────────────────────────────
GIT_USER_NAME="Ace (enso agent)"
GIT_USER_EMAIL="ace-agent@users.noreply.github.com"

# ── lore project memory ──────────────────────────────────────────────────
LORE_REMOTE="exedev@lore-host.exe.xyz:/srv/lore/repos"
# Optional: a context repo (e.g. lore-jointly) to wire into the admin agent's
# MCP config right away. Leave blank to attach memory per workspace later.
LORE_CONTEXT=""

# ── Machine ──────────────────────────────────────────────────────────────
TIMEZONE="America/Vancouver"     # job schedules use the VM's local timezone
OPERATOR_NAME="Shawn Adrian"     # seeds ~/.enso/docs/operator.md

# ── Sources ──────────────────────────────────────────────────────────────
ENSO_REF="main"                  # geekforbrains/enso branch, tag, or commit
BOOTSTRAP_REPO="https://github.com/nerdburn/enso-agent-bootstrap"
LORE_REPO="https://github.com/nerdburn/lore"
