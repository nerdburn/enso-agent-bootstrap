# ─────────────────────────────────────────────────────────────────────────
# enso-agent-bootstrap config. One file per agent, e.g. `ace.conf`.
# Contains SECRETS — gitignored (*.conf); keep it `chmod 600`.
# Every value can also be supplied as an environment variable to install.sh.
# Values shared by every agent can live in
# ~/.config/enso-agent-bootstrap/defaults.conf (bootstrap.sh merges it in).
# ─────────────────────────────────────────────────────────────────────────

# ── Identity ─────────────────────────────────────────────────────────────
AGENT_NAME="Ace"                 # Slack bot display name + manifest name
VM_NAME="ace-agent"              # exe.dev VM; reachable as <VM_NAME>.exe.xyz
VM_CPU=2                         # used by `bootstrap.sh new-vm`
VM_MEMORY=4GB
VM_DISK=20GB

# ── Slack ────────────────────────────────────────────────────────────────
# Create the Slack app first:  ./bootstrap.sh manifest ace.conf
# → paste at https://api.slack.com/apps?new_app=1 ("From an app manifest"),
#   Install to workspace, then copy:
#   OAuth & Permissions → Bot User OAuth Token               -> xoxb-...
#   Basic Information → App-Level Tokens (connections:write) -> xapp-...
# enso 0.4 keeps both in ~/.enso/config.json on the VM (mode 600); it has no
# hook for the exe.dev Slack gateway. Once installed, you may blank them here:
# re-runs reuse the tokens already in config.json.
SLACK_BOT_TOKEN=""
SLACK_APP_TOKEN=""

# Slack user IDs (U…) whose DMs are bound to the `default` operator workspace.
# Space/comma separated. Slack profile → ⋯ → "Copy member ID".
SLACK_OWNER_IDS="U02FB3JNB"

# Optional conversation (C…/D…) for job alerts and untargeted sends.
# Blank = the first owner's DM.
NOTIFY_CHANNEL=""

# ── Channels ─────────────────────────────────────────────────────────────
# Slack channels the agent answers in (when @mentioned), by name or C… id.
# All are bound to ONE workspace, CHANNEL_WORKSPACE (default: the first
# channel's name). The bot joins public channels itself; a private channel
# needs `/invite @<AGENT_NAME>` (the binding is written regardless).
CHANNELS=""                      # e.g. "merrin merrin-team"
CHANNEL_WORKSPACE=""             # e.g. "merrin" (lowercase kebab-case)
DM_WORKSPACE=""                  # where owner DMs go; blank = the `default` operator workspace

# ── Channel workspace policy ─────────────────────────────────────────────
# "full"       — abby/merrin house setup. Claude runs with
#                --dangerously-skip-permissions; project checkout is --add-dir'd;
#                lore is the only MCP. Everyone in a bound channel gets the
#                whole toolchain.
# "restricted" — accord/jointly-team setup. Claude runs against the committed
#                sandbox policy in templates/settings.restricted.json.tmpl:
#                strict permission allowlist (lore MCP tools only), network and
#                filesystem sandbox, credential env vars denied. Use for
#                client-facing channels that should not have shell/deploy access.
WORKSPACE_POLICY="full"

# Extras appended to the restricted policy (space or comma separated).
# Only consulted when WORKSPACE_POLICY=restricted.
RESTRICTED_ALLOW_DOMAINS=""      # extra sandbox network destinations, e.g. "cdn.sanity.io api.sanity.io"
# Extra absolute filesystem paths to protect. A trailing "/**" (or "/") marks a
# directory subtree — needed for dirs that may not exist yet at install time.
# Paths under the channel workspace also mirror into permissions.deny as
# Edit(<rel-path>) rules.
RESTRICTED_DENY_WRITE=""         # e.g. "/home/exedev/accord-ops /home/exedev/.enso/workspaces/ws/dir/**"

# ── Code ─────────────────────────────────────────────────────────────────
# exe.dev GitHub integrations to attach to this VM (bootstrap.sh integrations).
# Credentials stay at the exe.dev edge: git and gh go through
# https://github.int.exe.xyz, and only the attached repos are reachable.
# Create them as personal (not --team) integrations: they attach to
# vm:<agent>, plus tag:lore for lore-host's sync. Never tag an agent VM
# `lore`: that hands it every client's integrations.
GITHUB_INTEGRATIONS=""           # e.g. "inputlogic-merrin"
PROJECT_REPO=""                  # e.g. "inputlogic/merrin" → cloned to ~/apps/merrin

# ── Claude ───────────────────────────────────────────────────────────────
# Claude always runs on the Claude subscription: a long-lived token from
# `claude setup-token` here, or blank and log in once on the VM
# (`ssh -t <vm>.exe.xyz claude`, then /login).
CLAUDE_CODE_OAUTH_TOKEN=""
CLAUDE_AUTH="subscription"       # "exe-gateway" only to bill exe.dev's LLM gateway instead
DEFAULT_MODEL="opus"
DEFAULT_EFFORT="high"

# ── Tool credentials (optional; loaded into the service environment) ────
GH_TOKEN=""                      # only used when GITHUB_INTEGRATIONS is blank
VERCEL_TOKEN=""
CLOUDFLARE_API_TOKEN=""
CLOUDFLARE_ACCOUNT_ID=""
HEROKU_API_KEY=""
NEON_API_KEY=""                  # neonctl (Neon personal API key, napi_…)

# ── lore project memory ──────────────────────────────────────────────────
# The project's lore context (e.g. lore-merrin). The channel workspace reaches
# it over HTTP through the exe.dev `lore-mcp` integration, which
# `bootstrap.sh integrations` attaches to this VM. The admin agent also gets
# the stdio `lore mcp` server; that and the lore CLI need the VM's SSH key
# registered (bootstrap.sh lore-key).
LORE_CONTEXT=""
LORE_REMOTE="exedev@lore-host.exe.xyz:/srv/lore/repos"

# ── Machine ──────────────────────────────────────────────────────────────
TIMEZONE="America/Vancouver"     # job schedules use the VM's local timezone
OPERATOR_NAME="Shawn Adrian"     # seeds the operator knowledge note

# ── Sources ──────────────────────────────────────────────────────────────
ENSO_VERSION="0.4.0"             # official release (github.com/geekforbrains/enso); later
                                 # upgrades: `enso update apply` on the VM
# ENSO_HOME="/home/exedev/.enso" # default; abby-agent uses ~/.enso-abbe
BOOTSTRAP_REPO="https://github.com/nerdburn/enso-agent-bootstrap"
LORE_REPO="https://github.com/nerdburn/lore"
